SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only; used for the Marktplaats ad text. OPENAI_MODEL is optional.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=
# Server-only; WooCommerce web shop sync (docs/woocommerce-sync.md). Leave empty to switch it off.
WOOCOMMERCE_URL=https://woonwarmer.nl
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...
# Server-only; the WooCommerce webhook (shop changes back to the app). The secret key bypasses RLS
# and is used only by that webhook. Leave empty to switch the webhook off.
SUPABASE_SECRET_KEY=sb_secret_...
WOOCOMMERCE_WEBHOOK_SECRET=
